# Copy to .env and fill in. .env is git-ignored — never commit it.

# --- Required ---

# Target WhatsApp group JID. Run `node list-group.mjs` to discover it.
# Looks like: 1203630000000000000@g.us
WA_GROUP_ID=1203630000000000000@g.us

# Local display name of the SimpleX contact to bridge with, as shown by
# `/contacts` in the SimpleX Chat CLI.
SIMPLEX_CONTACT=dad

# --- Optional (defaults shown) ---

# SimpleX Chat CLI websocket address.
SIMPLEX_WS=ws://localhost:5225

# Folder the SimpleX CLI reads/writes files in. Must match the CLI's
# --files-folder argument. Incoming WhatsApp media is also staged here.
FILES_FOLDER=./files

# Where the WhatsApp <-> SimpleX message-id map is persisted (JSON).
MAP_FILE=./msgmap.json

# Baileys multi-file auth state folder (holds the WhatsApp session).
AUTH_DIR=./auth

# JSON map of number -> display label for forwarded WhatsApp senders.
NAMES_FILE=./names.json

# Header prefixed to every message coming from SimpleX into the WhatsApp group.
# Can be any language / script, e.g. "رسالة واردة".
DAD_HEADER=Message from Dad
